# Copy to .env. Environment variables override these values.
OLLAMA_HOST=http://localhost:11434
# live: the API may call Ollama; replay: only recorded report output (public demo).
BAULENS_LLM_MODE=live
# Dashboard -> API (local run without Docker).
BAULENS_API_URL=http://localhost:8000
# Docker Compose only
BAULENS_API_PORT=8000
BAULENS_DASHBOARD_PORT=8501
BAULENS_LLM_MODEL=qwen2.5:3b
OLLAMA_VERSION=0.40.18
